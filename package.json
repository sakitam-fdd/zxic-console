{
  "name": "zxic-console",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "description": "ZXIC Console — modern React control console for portable Wi-Fi devices",
  "scripts": {
    "dev": "rsbuild dev",
    "dev:mock": "rsbuild dev --env-mode mock",
    "serve": "pnpm dev",
    "build": "rsbuild build",
    "build:staging": "rsbuild build --env-mode staging",
    "build:mock": "rsbuild build --env-mode mock",
    "preview": "rsbuild preview",
    "preview:mock": "rsbuild preview --env-mode mock",
    "preview:build": "pnpm build && pnpm preview",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "lint": "pnpm check"
  },
  "browserslist": [
    "Chrome >= 107",
    "Edge >= 107",
    "Firefox >= 104",
    "Safari >= 16"
  ],
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@rsbuild/core": "^2.1.7",
    "@rsbuild/plugin-react": "^2.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.6",
    "shadcn": "^4.14.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "repository": "https://github.com/sakitam-fdd/zxic-console",
  "license": "MIT"
}
